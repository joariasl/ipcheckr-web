{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ipcheckr-web",
  "compatibility_date": "2026-11-12",
  "observability": {
    "enabled": false
  },
  "assets": {
    "directory": "./dist/",
    "not_found_handling": "single-page-application",
    "html_handling": "none"
  }
}